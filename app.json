{
  "expo": {
    "name": "ALPHA",
    "slug": "alpha",
    "scheme": "alpha",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.eastnoise.alpha",
      "buildNumber": "21",
      "appleTeamId": "K8387X4MHC",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "ko",
          "ja",
          "es",
          "de",
          "fr",
          "zh-Hans",
          "pt-BR",
          "zh-Hant",
          "it"
        ],
        "UIUserInterfaceStyle": "Dark"
      }
    },
    "android": {
      "package": "com.eastnoise.alpha",
      "versionCode": 7,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ALPHA to access your photos so you can personalize card images.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ko",
              "ja",
              "es",
              "de",
              "fr",
              "zh-Hans",
              "pt-BR",
              "zh-Hant",
              "it"
            ],
            "android": [
              "en",
              "ko",
              "ja",
              "es",
              "de",
              "fr",
              "zh-CN",
              "pt-BR",
              "zh-TW",
              "it"
            ]
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "./plugins/withIosLocalizedInfoPlist"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
